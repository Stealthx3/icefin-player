From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Icefin Player <noreply@github.com>
Date: Tue, 10 Nov 2026 21:30:00 +0000
Subject: [PATCH 6/8] vo_libmpv: gpu-next: map hardware frames through mpv's
 hwdec interops

The carried backend created hwdec devices but loaded no interop, so hardware decoding on the Vulkan render API
fell back to copy mode ("Could not create device", then nvdec-copy). The Vulkan context now also creates mpv's
own ra (ra_create_pl) on the same pl_gpu, the backend loads the hwdec interops on it (all, or the one named by
--gpu-hwdec-interop) and passes MPV_RENDER_PARAM_X11_DISPLAY / WL_DISPLAY on as native resources as libmpv_gpu.c
does, and the video engine maps frames in a hardware format through ra_hwdec_mapper the way vo_gpu_next does
(one mapping slot, the textures handed to libplacebo in the frame's acquire callback). check_format accepts a
hardware format only when an interop takes it. Hardware frames are skipped by the VO screenshot, so mpv's
screenshot code downloads them itself.

Not covered: the FFmpeg Vulkan decoder (hwdec=vulkan) needs a decode queue and an mpvk_ctx the host doesn't give,
and the Dolby Vision enhancement layer is not mapped.

Icefin Player (PLAN 5.3).
---
diff --git a/video/out/gpu_next/context.c b/video/out/gpu_next/context.c
index 11eece2..38d2567 100644
--- a/video/out/gpu_next/context.c
+++ b/video/out/gpu_next/context.c
@@ -31,6 +31,7 @@
 #ifdef PL_HAVE_VULKAN
 #include "mpv/render_vk.h"                       // for mpv_vulkan_init_params
 #include <libplacebo/vulkan.h>                   // for pl_vulkan_import
+#include "video/out/placebo/ra_pl.h"             // for ra_create_pl
 #include "video/out/gpu_next/libmpv_gpu_next.h"  // for libmpv_gpu_next_context
 #include "video/out/gpu_next/ra.h"               // for ra_pl_create, ra_pl_...
 #endif
@@ -574,6 +575,20 @@ static int libmpv_gpu_next_init_vk(struct libmpv_gpu_next_context *ctx, mpv_rend
 
     ctx->ra = p->ra;
     ctx->gpu = p->gpu;
+
+    // mpv's own ra on the same pl_gpu, for the hwdec interops (CUDA, VAAPI and
+    // DRM PRIME import into Vulkan through ra_pl).
+    struct ra *mpra = ra_create_pl(p->gpu, ctx->log);
+    if (mpra) {
+        ctx->ra_ctx = talloc_zero(p, struct ra_ctx);
+        *ctx->ra_ctx = (struct ra_ctx) {
+            .ra = mpra,
+            .global = ctx->global,
+            .log = ctx->log,
+        };
+    } else {
+        MP_WARN(ctx, "No ra for hardware decoding interop; frames will be copied.\n");
+    }
     return 0;
 }
 
@@ -705,6 +720,11 @@ static void libmpv_gpu_next_destroy_vk(struct libmpv_gpu_next_context *ctx)
         ra_pl_destroy(&p->ra);
     }
 
+    if (ctx->ra_ctx) {
+        ra_free(&ctx->ra_ctx->ra);
+        ctx->ra_ctx = NULL;
+    }
+
     if (p->vulkan) {
         pl_gpu_finish(p->gpu);
         if (p->hold_sem)
diff --git a/video/out/gpu_next/libmpv_gpu_next.c b/video/out/gpu_next/libmpv_gpu_next.c
index a8ba83e..49f98dc 100644
--- a/video/out/gpu_next/libmpv_gpu_next.c
+++ b/video/out/gpu_next/libmpv_gpu_next.c
@@ -12,6 +12,11 @@
 #include "ta/ta_talloc.h"       // for talloc_free, talloc_zero
 #include "video.h"              // for pl_video_check_format, pl_video_init
 #include "video/hwdec.h"        // for hwdec_devices_create, hwdec_devices_d...
+#include "video/img_format.h"   // for IMGFMT_IS_HWACCEL
+#include "options/m_config.h"   // for mp_get_config_group
+#include "video/out/gpu/context.h" // for ra_ctx
+#include "video/out/gpu/hwdec.h" // for ra_hwdec_ctx_init, ra_hwdec_get
+#include "video/out/gpu/video.h" // for gl_video_conf
 #include "video/out/libmpv.h"   // for render_backend, get_mpv_render_param
 #include "video/out/vo.h"       // for vo_frame (ptr only), voctrl_screenshot
 
@@ -28,6 +33,13 @@ struct mp_rect;
 struct priv {
     struct libmpv_gpu_next_context *context; // Manages the API (e.g., OpenGL)
     struct pl_video *video_engine;           // Manages synchronous libplacebo rendering
+    struct ra_hwdec_ctx hwdec_ctx;           // hwdec interops (zero-copy), if the context has an ra
+};
+
+// Render params a hwdec interop looks up as ra native resources (as libmpv_gpu.c).
+static const char *const native_resource_names[] = {
+    [MPV_RENDER_PARAM_X11_DISPLAY] = "x11",
+    [MPV_RENDER_PARAM_WL_DISPLAY] = "wl",
 };
 
 /*
@@ -94,8 +106,26 @@ static int init(struct render_backend *ctx, mpv_render_param *params)
         return MPV_ERROR_VO_INIT_FAILED;
     }
 
-    // Create hardware decoder devices.
+    // Create hardware decoder devices and, when the context has mpv's ra, load
+    // the hwdec interops so hardware frames are mapped instead of copied.
     ctx->hwdec_devs = hwdec_devices_create();
+    if (p->context->ra_ctx) {
+        struct ra *ra = p->context->ra_ctx->ra;
+        for (int n = 0; params && params[n].type; n++) {
+            int t = params[n].type;
+            if (t > 0 && t < MP_ARRAY_SIZE(native_resource_names) && native_resource_names[t])
+                ra_add_native_resource(ra, native_resource_names[t], params[n].data);
+        }
+        struct gl_video_opts *opts = mp_get_config_group(NULL, ctx->global, &gl_video_conf);
+        p->hwdec_ctx = (struct ra_hwdec_ctx) {
+            .log = ctx->log,
+            .global = ctx->global,
+            .ra_ctx = p->context->ra_ctx,
+        };
+        ra_hwdec_ctx_init(&p->hwdec_ctx, ctx->hwdec_devs, opts->hwdec_interop, true);
+        talloc_free(opts);
+        pl_video_set_hwdec(p->video_engine, &p->hwdec_ctx);
+    }
     ctx->driver_caps = VO_CAP_ROTATE90 | VO_CAP_VFLIP;
     return 0;
 }
@@ -109,8 +139,10 @@ static void destroy(struct render_backend *ctx)
     struct priv *p = ctx->priv;
     if (!p) return;
 
+    pl_video_uninit(&p->video_engine); // releases the hwdec mapping first
+    if (p->hwdec_ctx.ra_ctx)
+        ra_hwdec_ctx_uninit(&p->hwdec_ctx);
     hwdec_devices_destroy(ctx->hwdec_devs);
-    pl_video_uninit(&p->video_engine);
     if (p->context) {
         p->context->fns->destroy(p->context); // This destroys the RA
         talloc_free(p->context);
@@ -213,6 +245,8 @@ static void reset(struct render_backend *ctx)
 static bool check_format(struct render_backend *ctx, int imgfmt)
 {
     struct priv *p = ctx->priv;
+    if (IMGFMT_IS_HWACCEL(imgfmt))
+        return p->hwdec_ctx.ra_ctx && ra_hwdec_get(&p->hwdec_ctx, imgfmt);
     return p->video_engine ? pl_video_check_format(p->video_engine, imgfmt) : false;
 }
 
diff --git a/video/out/gpu_next/libmpv_gpu_next.h b/video/out/gpu_next/libmpv_gpu_next.h
index aac72cf..54cc67e 100644
--- a/video/out/gpu_next/libmpv_gpu_next.h
+++ b/video/out/gpu_next/libmpv_gpu_next.h
@@ -21,6 +21,9 @@ struct libmpv_gpu_next_context {
     struct ra_next *ra;
     // The underlying GPU object, needed by the Host for resource management.
     pl_gpu gpu;
+    // mpv's ra on the same pl_gpu, for the hwdec interops (NULL if the
+    // implementation has none, then only software frames are rendered).
+    struct ra_ctx *ra_ctx;
 };
 
 /**
diff --git a/video/out/gpu_next/video.c b/video/out/gpu_next/video.c
index 4152fc5..e409701 100644
--- a/video/out/gpu_next/video.c
+++ b/video/out/gpu_next/video.c
@@ -18,6 +18,7 @@
 #include "video/mp_image.h"                // for mp_image, mp_image_params
 #include "video/out/gpu_next/ra.h"         // for ra_next_find_fmt, ra_next_...
 #include "video/out/gpu/video.h"           // for gl_video_opts, gl_video_conf
+#include "video/out/gpu/hwdec.h"           // for ra_hwdec_mapper, ra_hwdec_get
 #include "video/out/vo.h"                  // for vo_frame
 
 // Forward declarations
@@ -49,6 +50,16 @@ struct pl_video_osd_state {
     struct pl_overlay overlays[MAX_OSD_PARTS];      // The final overlays to be rendered.
 };
 
+/**
+ * @brief Mapping state of the hardware frame being shown (as vo_gpu_next's
+ * hwdec_slot). The mapper's textures are ra_pl textures, so they are pl_tex.
+ */
+struct hwdec_slot {
+    struct ra_hwdec_mapper *mapper;
+    struct mp_image *owner;   // queue entry image that owns the mapping
+    bool acquired;            // between acquire and release of a render pass
+};
+
 /**
  * @brief Main structure managing synchronous libplacebo video rendering.
  *
@@ -81,6 +92,10 @@ struct pl_video {
 
     // Color adjustment state
     struct mp_csp_equalizer_state *video_eq; // Manages brightness, contrast, hue, etc.
+
+    // Hardware decoding interop (zero-copy); NULL when only software frames are rendered.
+    struct ra_hwdec_ctx *hwdec_ctx;
+    struct hwdec_slot hwdec;
 };
 
 /**
@@ -89,8 +104,138 @@ struct pl_video {
  */
 struct frame_priv {
     struct pl_video *p; // A pointer back to the main pl_video engine struct.
+    struct ra_hwdec *hwdec; // The interop mapping this frame, or NULL (uploaded).
 };
 
+static void slot_unmap(struct hwdec_slot *s)
+{
+    assert(!s->acquired);
+    if (!s->mapper)
+        return;
+    ra_hwdec_mapper_unmap(s->mapper);
+    s->owner = NULL;
+}
+
+static bool slot_reconfig(struct pl_video *p, struct hwdec_slot *s,
+                          struct ra_hwdec *hwdec, const struct mp_image_params *par)
+{
+    if (s->mapper) {
+        if (mp_image_params_static_equal(par, &s->mapper->src_params)) {
+            s->mapper->src_params.repr.dovi = par->repr.dovi;
+            s->mapper->dst_params.repr.dovi = par->repr.dovi;
+            s->mapper->src_params.color.hdr = par->color.hdr;
+            s->mapper->dst_params.color.hdr = par->color.hdr;
+            return true;
+        }
+        slot_unmap(s);
+        ra_hwdec_mapper_free(&s->mapper);
+    }
+    s->mapper = ra_hwdec_mapper_create(hwdec, par);
+    if (!s->mapper) {
+        mp_msg(p->log, MSGL_ERR, "Initializing texture for hardware decoding failed.\n");
+        return false;
+    }
+    return true;
+}
+
+static void slot_uninit(struct hwdec_slot *s)
+{
+    if (s->acquired && s->mapper)
+        ra_hwdec_mapper_end_access(s->mapper);
+    s->acquired = false;
+    slot_unmap(s);
+    ra_hwdec_mapper_free(&s->mapper);
+}
+
+// Fill frame->num_planes and the per-plane component mapping from the mapped
+// format (as vo_gpu_next's setup_hwdec_plane_mapping).
+static void setup_hwdec_plane_mapping(struct pl_frame *frame, const struct mp_imgfmt_desc *desc)
+{
+    frame->num_planes = desc->num_planes;
+    for (int n = 0; n < frame->num_planes; n++) {
+        struct pl_plane *plane = &frame->planes[n];
+        int *map = plane->component_mapping;
+        for (int c = 0; c < mp_imgfmt_desc_get_num_comps(desc); c++) {
+            if (desc->comps[c].plane != n)
+                continue;
+            uint8_t offset = desc->comps[c].offset;
+            int index = plane->components++;
+            while (index > 0 && desc->comps[map[index - 1]].offset > offset) {
+                map[index] = map[index - 1];
+                index--;
+            }
+            map[index] = c;
+        }
+    }
+}
+
+static bool hwdec_acquire(pl_gpu gpu, struct pl_frame *frame)
+{
+    struct mp_image *mpi = frame->user_data;
+    struct frame_priv *fp = mpi->priv;
+    struct pl_video *p = fp->p;
+    struct hwdec_slot *s = &p->hwdec;
+    if (!slot_reconfig(p, s, fp->hwdec, &mpi->params))
+        return false;
+    if (s->owner != mpi) {
+        // One frame is acquired at a time (no interpolation here), so the
+        // previous owner is not in use and its mapping can go.
+        if (s->acquired) {
+            mp_msg(p->log, MSGL_ERR, "Hardware frame is still in use.\n");
+            return false;
+        }
+        slot_unmap(s);
+        if (ra_hwdec_mapper_map(s->mapper, mpi) < 0) {
+            mp_msg(p->log, MSGL_ERR, "Mapping hardware decoded surface failed.\n");
+            return false;
+        }
+        s->owner = mpi;
+    }
+    if (ra_hwdec_mapper_begin_access(s->mapper) < 0)
+        return false;
+    s->acquired = true;
+    for (int n = 0; n < frame->num_planes; n++) {
+        struct ra_tex *ratex = s->mapper->tex[n];
+        if (!ratex)
+            return false;
+        frame->planes[n].texture = (pl_tex) ratex->priv;
+    }
+    return true;
+}
+
+static void hwdec_release(pl_gpu gpu, struct pl_frame *frame)
+{
+    struct mp_image *mpi = frame->user_data;
+    struct frame_priv *fp = mpi->priv;
+    struct hwdec_slot *s = &fp->p->hwdec;
+    if (!s->acquired)
+        return;
+    ra_hwdec_mapper_end_access(s->mapper);
+    s->acquired = false;
+}
+
+// Describe a hardware frame for libplacebo; the planes' textures are filled
+// in by hwdec_acquire when libplacebo renders it.
+static bool map_hwdec_frame(struct pl_video *p, struct mp_image *mpi, struct pl_frame *frame)
+{
+    struct frame_priv *fp = mpi->priv;
+    if (!slot_reconfig(p, &p->hwdec, fp->hwdec, &mpi->params))
+        return false;
+    struct mp_image_params par = p->hwdec.mapper->dst_params;
+    mp_image_params_guess_csp(&par);
+    *frame = (struct pl_frame) {
+        .color = par.color,
+        .repr = par.repr,
+        .crop = { .x0 = 0, .y0 = 0, .x1 = mpi->w, .y1 = mpi->h },
+        .acquire = hwdec_acquire,
+        .release = hwdec_release,
+    };
+    struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(par.imgfmt);
+    setup_hwdec_plane_mapping(frame, &desc);
+    pl_frame_set_chroma_location(frame, par.chroma_location);
+    return true;
+}
+
 /**
  * @brief Callback to map an mp_image to a pl_frame for rendering.
  *
@@ -109,9 +254,10 @@ static bool map_frame(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src
     struct frame_priv *fp = mpi->priv;
     struct pl_video *p = fp->p;
 
-    // Use the RA helper to upload the mp_image data to a new set of textures
-    // and populate the pl_frame struct with the result.
-    if (!ra_upload_mp_image(p->ra, frame, mpi)) {
+    // Hardware frames are mapped by an interop (zero-copy); others are uploaded
+    // by the RA helper into a new set of textures.
+    fp->hwdec = p->hwdec_ctx ? ra_hwdec_get(p->hwdec_ctx, mpi->imgfmt) : NULL;
+    if (fp->hwdec ? !map_hwdec_frame(p, mpi, frame) : !ra_upload_mp_image(p->ra, frame, mpi)) {
         talloc_free(mpi); // Clean up the mp_image reference on failure
         return false;
     }
@@ -144,8 +290,14 @@ static void unmap_frame(pl_gpu gpu, struct pl_frame *frame,
     struct frame_priv *fp = mpi->priv;
     struct pl_video *p = fp->p;
 
-    // Use the RA helper to destroy the GPU textures associated with the frame.
-    ra_cleanup_pl_frame(p->ra, frame);
+    // A mapped hardware frame's textures belong to the mapper: drop the mapping
+    // if this entry owns it. Uploaded frames' textures are destroyed.
+    if (fp->hwdec) {
+        if (p->hwdec.owner == mpi)
+            slot_unmap(&p->hwdec);
+    } else {
+        ra_cleanup_pl_frame(p->ra, frame);
+    }
     // Free the mp_image reference itself.
     talloc_free(mpi);
 }
@@ -190,6 +342,11 @@ struct pl_video *pl_video_init(struct mpv_global *global, struct mp_log *log, st
     return p;
 }
 
+void pl_video_set_hwdec(struct pl_video *p, struct ra_hwdec_ctx *hwdec_ctx)
+{
+    p->hwdec_ctx = hwdec_ctx;
+}
+
 /**
  * @brief Shuts down and destroys the rendering engine and its resources.
  * @param p_ptr A pointer to the pl_video engine pointer to be freed.
@@ -199,6 +356,7 @@ void pl_video_uninit(struct pl_video **p_ptr) {
     if (!p) return;
 
     ra_next_queue_destroy(&p->queue);
+    slot_uninit(&p->hwdec);
 
     // Clean up all allocated OSD GPU resources
     for (int i = 0; i < MP_ARRAY_SIZE(p->osd_state_storage.entries); i++) {
@@ -468,6 +626,11 @@ struct mp_image *pl_video_screenshot(struct pl_video *p, struct vo_frame *frame)
         return NULL;
     }
 
+    // Hardware frames aren't uploaded here; mpv's screenshot code downloads
+    // the frame itself when the VO gives none.
+    if (IMGFMT_IS_HWACCEL(frame->current->imgfmt))
+        return NULL;
+
     struct mp_image *res = NULL;
     struct pl_frame source_frame = {0};
     pl_tex fbo = NULL;
diff --git a/video/out/gpu_next/video.h b/video/out/gpu_next/video.h
index 0f62ee2..fedf8ea 100644
--- a/video/out/gpu_next/video.h
+++ b/video/out/gpu_next/video.h
@@ -10,6 +10,7 @@ struct mp_osd_res;
 struct mp_rect;
 struct mpv_global;
 struct osd_state;
+struct ra_hwdec_ctx;
 struct ra_next;
 struct vo_frame;
 
@@ -23,6 +24,10 @@ struct pl_video *pl_video_init(struct mpv_global *global, struct mp_log *log, st
  */
 void pl_video_uninit(struct pl_video **p_ptr);
 
+// Map frames in formats one of these interops takes (zero-copy) instead of
+// uploading them. The context must outlive the engine.
+void pl_video_set_hwdec(struct pl_video *p, struct ra_hwdec_ctx *hwdec_ctx);
+
 /**
  * Synchronously renders a video frame to a display target using libplacebo.
  */
