    {"id": "addserver", "group": "Sign-in", "name": "Add a server", "hash": "#/addserver"},
    {"id": "login", "group": "Sign-in", "name": "Sign in", "hash": "#/login?serverid={sid}"},
    {"id": "forgotpassword", "group": "Sign-in", "name": "Forgot password", "hash": "#/forgotpassword"},

    {"id": "dashboard", "group": "Server dashboard", "name": "Dashboard (stays jellyfin-web's)", "hash": "#/dashboard", "target": "dashboard"},

    {"id": "music-capsule", "group": "Music", "name": "Now playing bar on the home", "hash": "#/home", "needs": "music"},
    {"id": "music-queue", "group": "Music", "name": "Now playing and queue", "hash": "#/queue", "needs": "music"},
    {"id": "music-lyrics", "group": "Music", "name": "Lyrics", "hash": "#/lyrics", "needs": "music"}
