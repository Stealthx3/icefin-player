{
  "palette": {
    "magenta": "#d0167a",
    "ink": "#160b2e"
  },
  "color": {
    "background": "{palette.ink}",
    "surface": "#24124a",
    "surfaceRaised": "#331a66",
    "text": "#fff4c2",
    "textSecondary": "rgba(255, 244, 194, 0.75)",
    "accent": "{palette.magenta}",
    "accentStrong": "#a0105d",
    "onAccent": "#ffffff",
    "focus": { "$value": "#ffcc00", "$description": "focus ring and focused fill" },
    "onFocus": "#160b2e",
    "divider": "rgba(255, 244, 194, 0.2)",
    "error": "#ff3b30",
    "onError": "#ffffff",
    "inputBackground": "rgba(255, 255, 255, 0.12)",
    "hover": "rgba(208, 22, 122, 0.3)"
  },
  "shape": { "cardRadius": "0.8em" },
  "material": { "panel": { "tint": "rgba(36, 18, 74, 0.55)", "blur": "18px", "saturate": "1.5", "opaque": "#24124a" } },
  "palettes": {
    "dawn": { "color": { "background": "#204060" } },
    "night": { "color": { "background": "#000010" }, "shape": { "cardRadius": "0.2em" } },
    "winter": { "color": { "accent": "#3080ff" } },
    "summer": { "color": { "accent": "#ff8000" } }
  },
  "parallax": { "highlight": "rgba(255, 255, 255, 0.35)" },
  "font": { "family": "monospace" }
}
