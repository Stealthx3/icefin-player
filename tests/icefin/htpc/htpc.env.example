# HTPC test tier config (docs/LAB.md "HTPC tier"). Copy to htpc.env (git-ignored) and fill in.
HTPC_HOST=htpc.local            # hostname or LAN IP of the Bazzite HTPC
HTPC_USER=                      # the account that auto-logs in to the TV session (tests run inside that session)
HTPC_SSH_PORT=22
HTPC_SSH_KEY="$HOME/.ssh/id_ed25519"   # its .pub goes in the HTPC's ~/.ssh/authorized_keys
HTPC_HOSTKEY=accept-new         # pin the host key on first connect
HTPC_DEST=.local/share/icefin-lab      # lab dir under the HTPC user's home; nothing is written elsewhere except ~/.var/app/<app id>
HTPC_APP_ID=io.github.stealthx3.IcefinPlayer
HTPC_PORT_SHIFT=10000           # tunnelled ports on the HTPC: 18096/18097 (lab Jellyfin servers), 18099 (Flatpak repo)
HTPC_REPO_PORT=8099             # where the lab VM serves ~/fp-repo
HTPC_QUIET_HOURS=               # e.g. 22-08 (HTPC local time): no tests that take over the TV
HTPC_BUSY_PROCS="reaper"        # don't start while these run (reaper = a Steam game)
HTPC_ALLOW_SESSION_SWITCH=0     # 1 lets `htpc.sh session plasma|gamescope` log the TV session out and back in
HTPC_LAB_ENV=lab.env            # lab config of the build VM
