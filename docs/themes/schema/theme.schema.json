{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Stealthx3/icefin-player/docs/themes/schema/theme.schema.json",
  "title": "Icefin theme package metadata (theme.json), schema 1",
  "description": "Shared with the server-plugin plan. Semantic checks (files exist inside the package, tokens resolve) are the engine's: src/icefin/theme/ThemePackage.cpp.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "type": "string"
    },
    "styles": {
      "$ref": "#/$defs/relPath"
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relPath"
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "file"
        ],
        "properties": {
          "family": {
            "type": "string",
            "pattern": "^[A-Za-z0-9 _-]{1,64}$"
          },
          "file": {
            "$ref": "#/$defs/relPath"
          },
          "weight": {
            "type": [
              "integer",
              "string"
            ]
          },
          "style": {
            "enum": [
              "normal",
              "italic",
              "oblique"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "presets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "tokens.schema.json#/$defs/group"
      }
    },
    "schemes": {
      "description": "Colour schemes (PLAN 9.20): token overrides applied after the preset; the user picks one across themes (Dark, ...).",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,23}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 32 },
          "tokens": { "$ref": "tokens.schema.json#/$defs/group" },
          "presets": {
            "type": "object",
            "additionalProperties": { "$ref": "tokens.schema.json#/$defs/group" }
          }
        }
      }
    },
    "sounds": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "focus",
          "select",
          "back",
          "navigate",
          "error"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/relPath"
      }
    },
    "backdrop": {
      "type": "object",
      "required": [
        "shader"
      ],
      "additionalProperties": false,
      "properties": {
        "shader": {
          "$ref": "#/$defs/relPath",
          "description": "A GLSL fragment body (.frag, built-in themes) or a precompiled .qsb"
        },
        "params": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]{0,23}$",
            "not": {
              "enum": [
                "time",
                "resolution",
                "main"
              ]
            }
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "fps": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "relPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
    }
  }
}
