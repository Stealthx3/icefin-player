{
  "schema": 1,
  "id": "tide",
  "name": "Tide",
  "version": "0.2.1",
  "description": "A horizontal row of category icons crossing a vertical list of items at a fixed focus point, over an animated wave on a gradient whose colour follows the month and the time of day; original line icons.",
  "styles": "styles.css",
  "scripts": [
    "tide.js"
  ],
  "backdrop": {
    "shader": "backdrop/wave.frag",
    "params": {
      "colorTop": "color.waveTop",
      "colorBottom": "color.waveBottom",
      "lineColor": "color.waveLine",
      "shade": "color.shade",
      "speed": 0.35
    },
    "fps": 30
  },
  "sounds": {
    "focus": "sounds/focus.wav",
    "select": "sounds/select.wav",
    "back": "sounds/back.wav",
    "navigate": "sounds/navigate.wav",
    "error": "sounds/error.wav"
  },
  "schemes": {
    "dark": {
      "name": "Dark",
      "tokens": {
        "color": {
          "background": "#0b1a33",
          "surface": "rgba(255, 255, 255, 0.06)",
          "surfaceRaised": "rgba(8, 12, 22, 0.9)",
          "waveTop": "#163a70",
          "waveBottom": "#050c1a"
        },
        "palettes": {
