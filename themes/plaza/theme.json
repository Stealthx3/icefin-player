{
  "schema": 1,
  "id": "plaza",
  "name": "Plaza",
  "version": "0.2.0",
  "description": "A paged four-by-three grid of rounded channel tiles that cycle previews of their content, page arrows at the sides, and a bottom bar with the clock, the date and two round buttons; selecting a channel zooms it to fill the screen. Light grey and white with blue accents, pointer-first.",
  "styles": "styles.css",
  "scripts": [
    "plaza.js"
  ],
  "sounds": {
    "focus": "sounds/focus.wav",
    "select": "sounds/select.wav",
    "back": "sounds/back.wav",
    "navigate": "sounds/navigate.wav",
    "error": "sounds/error.wav"
  },
  "schemes": {
    "dark": {
      "name": "Dark",
      "tokens": {
        "color": {
          "background": "#1c1e21",
          "surface": "#2a2d31",
          "surfaceRaised": "#33373c",
          "text": "#eef0f2",
          "textSecondary": "rgba(238, 240, 242, 0.7)",
          "divider": "#4a4e54",
          "bar": "#26292d",
          "tileEmpty": "#2f3338",
          "inputBackground": "#2a2d31",
          "onAccent": "#062433",
          "onFocus": "#062433",
          "hover": "rgba(52, 189, 242, 0.2)"
        }
      }
    }
  }
}
