{
  "$description": "Plaza: a light grey field, white channels in grey frames, blue accents. Colours sampled from the benchmark target (docs/themes/references/plaza.json); everything else is Icefin's.",
  "palette": {
    "paper": "#ececec",
    "white": "#ffffff",
    "silver": "#b7b6bb",
    "sky": "#34bdf2",
    "blue": "#1b8fd6",
    "ink": "#3a4148"
  },
  "color": {
    "background": "{palette.paper}",
    "surface": "{palette.white}",
    "surfaceRaised": "#f7f8f9",
    "text": "{palette.ink}",
    "textSecondary": "rgba(58, 65, 72, 0.66)",
    "accent": "{palette.sky}",
    "accentStrong": "{palette.blue}",
    "onAccent": "#ffffff",
    "focus": "{palette.sky}",
    "onFocus": "#ffffff",
    "hover": "rgba(52, 189, 242, 0.16)",
    "divider": "{palette.silver}",
    "error": "#e0514a",
    "onError": "#ffffff",
    "inputBackground": "#ffffff",
    "bar": "#d0d1d8",
    "tileEmpty": "#e3e6e9"
  },
  "shape": {
    "cardRadius": "1.1em"
  },
  "osd": {
    "panelBackground": "rgb(var(--icefin-color-surface-channel) / 0.94)",
    "panelRadius": "1.6em",
    "buttonRadius": "50%",
    "buttonBackground": "{color.surfaceRaised}",
    "focusFill": "{color.surface}",
    "focusText": "{color.text}",
    "focusRing": "{color.focus}",
    "progress": "{color.focus}",
    "text": "{color.text}",
    "menuRadius": "1.2em",
    "headerBackground": "linear-gradient(180deg, rgb(58 65 72 / 0.80) 0%, rgb(58 65 72 / 0.64) 18%, rgb(58 65 72 / 0.44) 36%, rgb(58 65 72 / 0.26) 54%, rgb(58 65 72 / 0.11) 72%, rgb(58 65 72 / 0.04) 88%, transparent 100%)"
  }
}
