{
  "$description": "Harbor: a dark menu beside a teal-lit field, cyan focus. Colours sampled from the benchmark target (docs/themes/references/harbor.json); everything else is Icefin's.",
  "palette": {
    "night": "#010607",
    "deep": "#021118",
    "teal": "#062c3b",
    "glow": "#083c51",
    "slate": "#0e1517",
    "rail": "#0e1315",
    "railEdge": "#040505",
    "cyan": "#0f85a5",
    "cyanDeep": "#0a5b71",
    "mist": "#f0f0f0"
  },
  "color": {
    "background": "{palette.night}",
    "surface": "{palette.slate}",
    "surfaceRaised": "#1b2629",
