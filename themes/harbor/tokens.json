    "textSecondary": "rgba(240, 240, 240, 0.62)",
    "accent": "{palette.cyan}",
    "accentStrong": "{palette.cyanDeep}",
    "onAccent": "#ffffff",
    "focus": "{palette.cyan}",
    "onFocus": "#ffffff",
