{
  "schema": 1,
  "id": "harbor",
  "name": "Harbor",
  "version": "0.3.0",
  "description": "The target's layout: a persistent menu down the left, each entry with its categories and shelves of posters over the focused item's fanart; libraries as the media window (the path and Sort by, posters or a list, the side blade); details as the info page; dark panels with a cyan title bar and cyan focus; the menu over any screen.",
  "styles": "styles.css",
  "scripts": [
    "kit.js",
    "panel.js",
    "views.js",
    "data.js",
    "home.js",
    "menus.js",
    "itemmenu.js",
    "details.js",
    "guide.js",
    "tv.js",
    "library.js",
    "np.js",
    "player.js",
    "settings.js",
    "account.js",
    "interim.js",
    "harbor.js"
  ],
  "sounds": {
    "focus": "sounds/focus.wav",
    "select": "sounds/select.wav",
    "back": "sounds/back.wav",
    "navigate": "sounds/navigate.wav",
    "error": "sounds/error.wav"
  },
  "schemes": {
    "dark": {
      "name": "Dark",
      "tokens": {
        "color": {
          "background": "#000000",
          "surface": "#070b0c",
          "surfaceRaised": "#11191b",
          "rail": "#050808",
          "railEdge": "#000000",
          "glow": "#052a39",
          "glowMid": "#041c27",
          "glowEdge": "#010a0e",
          "scrim": "rgba(0, 3, 5, 0.65)"
        }
      }
    }
  },
  "music": {
    "startup": "music/startup.ogg",
    "ambient": "music/ambient.ogg",
    "jingles": {
      "menu": "music/menu.ogg",
      "goodbye": "music/goodbye.ogg"
    }
  }
