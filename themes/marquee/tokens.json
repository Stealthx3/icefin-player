{
  "$description": "Marquee: black field, one red accent, white focus. Layout and colours follow the benchmark target; everything else is Icefin's (no logo, ribbon or proprietary font).",
  "palette": {
    "black": "#000000",
    "ink": "#141414",
    "char": "#232323",
    "red": "#e50914",
    "white": "#ffffff"
  },
  "color": {
    "background": "{palette.black}",
    "surface": "{palette.ink}",
    "surfaceRaised": "{palette.char}",
    "text": "#ffffff",
    "textSecondary": "rgba(255, 255, 255, 0.66)",
    "accent": "{palette.red}",
    "accentStrong": "#b20710",
    "onAccent": "#ffffff",
    "focus": "{palette.white}",
    "onFocus": "#000000",
    "hover": "rgba(255, 255, 255, 0.12)",
    "divider": "rgba(255, 255, 255, 0.14)",
    "error": "#e87c03",
    "onError": "#000000",
    "inputBackground": "rgba(255, 255, 255, 0.1)",
    "billboardScrim": "rgba(0, 0, 0, 0.88)",
    "railScrim": "rgba(0, 0, 0, 0.94)",
    "match": "#46d369"
  },
  "shape": { "cardRadius": "0.25em" }
}
