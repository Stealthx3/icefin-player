{
  "schema": 1,
  "id": "lumen",
  "name": "Lumen",
  "version": "0.3.0",
  "description": "The target's current layout: a frosted sidebar from the left over any screen, a paging hero over the featured item's backdrop, rows of cards that lift and tilt with a moving highlight, product pages over full-bleed art, the letter row for search, the standard player with an info panel; glass panels and white pills.",
  "styles": "styles.css",
  "fonts": [
    {
      "family": "Inter",
      "file": "fonts/Inter.woff2",
      "weight": "100 900",
      "style": "normal"
    }
  ],
  "scripts": [
    "kit.js",
    "panel.js",
    "views.js",
    "data.js",
    "home.js",
    "menus.js",
    "itemmenu.js",
    "details.js",
    "guide.js",
    "tv.js",
    "library.js",
    "np.js",
    "player.js",
    "settings.js",
    "account.js",
    "interim.js",
    "lumen.js"
  ],
  "sounds": {
    "focus": "sounds/focus.wav",
    "select": "sounds/select.wav",
    "back": "sounds/back.wav",
    "navigate": "sounds/navigate.wav",
    "error": "sounds/error.wav"
  },
  "music": {
    "startup": "music/startup.ogg",
    "ambient": "music/ambient.ogg",
    "jingles": {
      "menu": "music/menu.ogg",
      "goodbye": "music/goodbye.ogg"
    }
  },
  "schemes": {
    "dark": {
      "name": "Dark",
      "tokens": {
        "color": {
          "background": "#000000",
          "surface": "#111114",
          "surfaceRaised": "#1c1c20",
          "shelfScrim": "rgba(0, 0, 0, 0.88)"
        },
        "material": {
          "bar": {
            "tint": "rgba(30, 30, 36, 0.5)",
            "opaque": "#18181c"
          },
          "panel": {
            "tint": "rgba(14, 14, 16, 0.6)",
            "opaque": "#111114"
          }
        }
      }
    }
  }
}
