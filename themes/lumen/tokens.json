{
  "$description": "Lumen: black under the focused item's backdrop, white type, frosted glass for everything that floats, white pills for focus. Layout from the benchmark target's published guidelines; everything else is IceFin Player's.",
  "palette": {
    "night": "#0a0a0c",
    "graphite": "#1c1c20",
    "steel": "#2c2c32",
    "white": "#ffffff",
    "sky": "#3a8dff"
  },
  "color": {
    "background": "{palette.night}",
    "surface": "{palette.graphite}",
    "surfaceRaised": "{palette.steel}",
    "text": "#f5f5f7",
    "textSecondary": "rgba(245, 245, 247, 0.6)",
    "accent": "{palette.sky}",
    "accentStrong": "#2a74e0",
    "onAccent": "#ffffff",
    "focus": "{palette.white}",
    "onFocus": "#111114",
    "hover": "rgba(255, 255, 255, 0.14)",
    "divider": "rgba(255, 255, 255, 0.12)",
    "error": "#ff453a",
    "onError": "#ffffff",
    "inputBackground": "rgba(255, 255, 255, 0.1)",
    "shelfScrim": "rgba(10, 10, 12, 0.85)",
    "rail": "#0e0e10",
    "railEdge": "#000000",
    "glow": "#1c1c22",
    "glowMid": "#101014",
    "glowEdge": "#000000",
    "scrim": "rgba(0, 0, 0, 0.55)",
    "backdropTop": "#1a1b20",
    "backdropMid": "#0c0c0f",
    "backdropBottom": "#000000",
    "floor": "#000000",
    "panelLo": "rgba(40, 40, 46, 0.72)",
    "panelEdge": "rgba(255, 255, 255, 0.16)",
    "focusRing": "#ffffff",
    "pill": "rgba(255, 255, 255, 0.16)",
    "bar": "rgba(28, 28, 32, 0.8)",
    "panel": "rgba(36, 36, 42, 0.86)",
    "tile": "rgba(255, 255, 255, 0.08)",
    "positive": "#34c759"
  },
  "material": {
    "bar": {
      "tint": "rgba(60, 60, 68, 0.42)",
      "blur": "28px",
      "saturate": "1.8",
      "opaque": "#2a2a30"
    },
    "panel": {
      "tint": "rgba(28, 28, 32, 0.55)",
      "blur": "36px",
      "saturate": "1.6",
      "opaque": "#1c1c20"
    }
  },
  "parallax": {
    "highlight": "rgba(255, 255, 255, 0.28)",
    "lift": "1.1"
  },
  "shape": {
    "cardRadius": "0.75em",
    "panelRadius": "1.6em",
    "pillRadius": "999px"
  },
  "osd": {
    "panelBackground": "{material.bar.tint}",
    "panelBlur": "{material.bar.blur}",
    "panelRadius": "1.2em",
    "buttonRadius": "50%",
    "focusFill": "{color.focus}",
    "focusText": "{color.onFocus}",
    "progress": "{color.text}",
    "progressHeight": "0.45em",
    "menuRadius": "1em"
  }
}
