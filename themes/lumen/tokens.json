{
  "$description": "Lumen: near-black field, white type, translucent frosted panels over the artwork. Layout and colours follow the benchmark target; everything else is Icefin's.",
  "palette": {
    "night": "#0a0a0c",
    "graphite": "#1c1c20",
    "steel": "#2c2c32",
    "white": "#ffffff",
    "sky": "#3a8dff"
  },
  "color": {
    "background": "{palette.night}",
    "surface": "{palette.graphite}",
    "surfaceRaised": "{palette.steel}",
    "text": "#f5f5f7",
    "textSecondary": "rgba(245, 245, 247, 0.6)",
    "accent": "{palette.sky}",
    "accentStrong": "#2a74e0",
    "onAccent": "#ffffff",
    "focus": "{palette.white}",
    "onFocus": "#111114",
    "hover": "rgba(255, 255, 255, 0.14)",
    "divider": "rgba(255, 255, 255, 0.12)",
    "error": "#ff453a",
    "onError": "#ffffff",
    "inputBackground": "rgba(255, 255, 255, 0.1)",
    "shelfScrim": "rgba(10, 10, 12, 0.85)"
  },
  "material": {
    "bar": { "tint": "rgba(60, 60, 68, 0.42)", "blur": "28px", "saturate": "1.8", "opaque": "#2a2a30" },
    "panel": { "tint": "rgba(28, 28, 32, 0.55)", "blur": "36px", "saturate": "1.6", "opaque": "#1c1c20" }
  },
  "parallax": { "highlight": "rgba(255, 255, 255, 0.28)", "lift": "1.12" },
  "shape": { "cardRadius": "0.7em" }
}
