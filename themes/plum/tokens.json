{
  "$description": "Plum: a deep blue-violet field under a violet-to-magenta header band, a light lavender focus ring. Colours sampled from the benchmark target (docs/themes/references/plum.json); everything else is Icefin's.",
  "palette": {
    "aubergine": "#2b0f45",
    "plum": "#3d1663",
    "violet": "#6c2bd9",
    "lilac": "#b99be6",
    "snow": "#ffffff",
    "indigo": "#131e67",
    "navy": "#1b1e34",
    "lavender": "#b7afd2"
  },
  "color": {
    "background": "{palette.indigo}",
    "surface": "{palette.plum}",
    "surfaceRaised": "#4c1f7a",
    "text": "{palette.snow}",
    "textSecondary": "rgba(255, 255, 255, 0.7)",
    "accent": "{palette.violet}",
    "accentStrong": "#5520b0",
    "onAccent": "#ffffff",
    "focus": "{palette.snow}",
    "onFocus": "{palette.aubergine}",
    "hover": "rgba(255, 255, 255, 0.14)",
    "divider": "rgba(255, 255, 255, 0.16)",
    "error": "#ff6b6b",
    "onError": "#2b0f45",
    "inputBackground": "rgba(255, 255, 255, 0.1)",
    "rail": "{palette.indigo}",
    "header": "#1a0a5d",
    "highlight": "{palette.lilac}",
    "headerMid": "#4a1a9e",
    "headerEdge": "#c0307a",
    "focusRing": "{palette.lavender}",
    "focusFill": "rgba(255, 255, 255, 0.16)",
    "panel": "{palette.navy}",
    "panelEdge": "#6b677f"
  },
  "shape": {
    "cardRadius": "0.25em"
  }
}
