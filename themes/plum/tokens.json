{
  "$description": "Plum: deep purple panels, a white focus frame. Layout and colours follow the benchmark target; everything else is Icefin's.",
  "palette": {
    "aubergine": "#2b0f45",
    "plum": "#3d1663",
    "violet": "#6c2bd9",
    "lilac": "#b99be6",
    "snow": "#ffffff"
  },
  "color": {
    "background": "{palette.aubergine}",
    "surface": "{palette.plum}",
    "surfaceRaised": "#4c1f7a",
    "text": "{palette.snow}",
    "textSecondary": "rgba(255, 255, 255, 0.7)",
    "accent": "{palette.violet}",
    "accentStrong": "#5520b0",
    "onAccent": "#ffffff",
    "focus": "{palette.snow}",
    "onFocus": "{palette.aubergine}",
    "hover": "rgba(255, 255, 255, 0.14)",
    "divider": "rgba(255, 255, 255, 0.16)",
    "error": "#ff6b6b",
    "onError": "#2b0f45",
    "inputBackground": "rgba(255, 255, 255, 0.1)",
    "rail": "#24093b",
    "header": "#1e0733",
    "highlight": "{palette.lilac}"
  },
  "shape": { "cardRadius": "0.25em" }
}
