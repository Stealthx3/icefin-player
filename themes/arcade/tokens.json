{
  "$description": "Arcade: near-black navy, light focus ring, blue accents. Colours sampled from the benchmark target (docs/themes/references/arcade.json); everything else is Icefin's.",
  "palette": {
    "slate": "#171d25",
    "deep": "#0e141b",
    "panel": "#23262e",
    "steel": "#3d4450",
    "blue": "#1a9fff",
    "white": "#ffffff",
    "night": "#0c1117",
    "bar": "#111417",
    "card": "#31363c",
    "pill": "#2f3439",
    "ring": "#e8eaec"
  },
  "color": {
    "background": "{palette.night}",
    "surface": "{palette.slate}",
    "surfaceRaised": "{palette.panel}",
    "text": "#dcdedf",
    "textSecondary": "rgba(220, 222, 223, 0.6)",
    "accent": "{palette.blue}",
    "accentStrong": "#0d7fd1",
    "onAccent": "#ffffff",
    "focus": "{palette.blue}",
    "onFocus": "#ffffff",
    "hover": "rgba(26, 159, 255, 0.18)",
    "divider": "rgba(255, 255, 255, 0.08)",
    "error": "#e0453a",
    "onError": "#ffffff",
    "inputBackground": "rgba(255, 255, 255, 0.08)",
    "scrim": "rgba(14, 20, 27, 0.72)",
    "panelEdge": "{palette.steel}",
    "bar": "{palette.bar}",
    "panel": "{palette.card}",
    "pill": "{palette.pill}",
    "focusRing": "{palette.ring}"
  },
  "shape": {
    "cardRadius": "0.35em"
