{
  "schema": 1,
  "id": "almanac",
  "name": "Almanac",
  "version": "0.2.0",
  "description": "A Live TV guide with channels down the side, a time axis across the top, programme cells sized by duration, a now line, and a small live preview of the focused channel in a corner; deep blue with a yellow-green focus.",
  "styles": "styles.css",
  "scripts": [
    "almanac.js"
  ],
  "sounds": {
    "focus": "sounds/focus.wav",
    "select": "sounds/select.wav",
    "back": "sounds/back.wav",
    "navigate": "sounds/navigate.wav",
    "error": "sounds/error.wav"
  },
  "schemes": {
    "dark": {
      "name": "Dark",
      "tokens": {
        "color": {
          "background": "#02081a",
          "surface": "#071a3d",
          "surfaceRaised": "#0d2a5c",
          "live": "#12305f"
        }
      }
    }
  }
}
