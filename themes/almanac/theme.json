{
  "schema": 1,
  "id": "almanac",
  "name": "Almanac",
  "version": "0.3.0",
  "description": "A cable-guide look on every screen: an information pane over rows like channels, a live or still picture in the corner, a tab strip, programme cells sized by duration with a now line in the guide, options in a list box and the hints in a bottom bar; deep blue with a yellow-green focus.",
  "styles": "styles.css",
  "scripts": [
    "kit.js",
    "panel.js",
    "grid.js",
    "data.js",
    "home.js",
    "itemmenu.js",
    "details.js",
    "guide.js",
    "tv.js",
    "library.js",
    "np.js",
    "player.js",
    "settings.js",
    "account.js",
    "interim.js"
  ],
  "sounds": {
    "focus": "sounds/focus.wav",
    "select": "sounds/select.wav",
    "back": "sounds/back.wav",
    "navigate": "sounds/navigate.wav",
    "error": "sounds/error.wav"
  },
  "music": {
    "startup": "music/startup.ogg",
    "ambient": "music/ambient.ogg",
    "jingles": {
      "goodbye": "music/goodbye.ogg"
    }
  },
  "schemes": {
    "dark": {
      "name": "Dark",
      "tokens": {
        "color": {
          "background": "#02081a",
          "surface": "#071a3d",
          "surfaceRaised": "#0d2a5c",
          "live": "#12305f"
        }
      }
    }
  }
}
