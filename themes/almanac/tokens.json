{
  "$description": "Almanac: deep blue guide, yellow-green focus, a lighter blue for what is on now. Layout and colours follow the benchmark target; everything else is Icefin's.",
  "palette": {
    "midnight": "#071a3d",
    "navy": "#0d2a5c",
    "denim": "#173b78",
    "lime": "#c8e639",
    "white": "#ffffff"
  },
  "color": {
    "background": "{palette.midnight}",
    "surface": "{palette.navy}",
    "surfaceRaised": "{palette.denim}",
    "text": "#eef3ff",
    "textSecondary": "rgba(238, 243, 255, 0.65)",
    "accent": "{palette.lime}",
    "accentStrong": "#a9c51f",
    "onAccent": "#0a1a33",
    "focus": "{palette.lime}",
    "onFocus": "#0a1a33",
    "hover": "rgba(200, 230, 57, 0.18)",
    "divider": "rgba(160, 190, 255, 0.22)",
    "error": "#ff6b5a",
    "onError": "#0a1a33",
    "inputBackground": "rgba(255, 255, 255, 0.1)",
    "live": "#1e4c96",
    "nowLine": "#ff5a3c"
  },
  "shape": { "cardRadius": "0.2em" },
  "osd": {
    "buttonRadius": "0.2em",
    "focusFill": "{color.focus}",
    "focusText": "{color.onFocus}",
    "progress": "{color.accent}",
    "progressHeight": "0.4em",
    "menuRadius": "0.2em"
  }
}
