{
  "schema": 1,
  "id": "mosaic",
  "name": "Mosaic",
  "version": "0.2.0",
  "description": "Large lowercase pivot headers across the top that slide with their sections, each a grid of flat tiles in three sizes with live tiles cycling content. Light grey with green tiles; typography carries the design.",
  "styles": "styles.css",
  "scripts": [
    "mosaic.js"
  ],
  "sounds": {
    "focus": "sounds/focus.wav",
    "select": "sounds/select.wav",
    "back": "sounds/back.wav",
    "navigate": "sounds/navigate.wav",
    "error": "sounds/error.wav"
  },
  "schemes": {
    "dark": {
      "name": "Dark",
      "tokens": {
        "color": {
          "background": "#111315",
          "surface": "#1f2326",
          "surfaceRaised": "#2a2f33",
          "text": "#f2f3f3",
          "textSecondary": "#b0b3b6",
          "focus": "#f2f3f3",
          "onFocus": "#111315",
          "divider": "rgba(255, 255, 255, 0.12)",
          "hover": "rgba(47, 143, 31, 0.22)",
          "inputBackground": "#1f2326",
          "backgroundMid": "#1a1d20",
          "backgroundLow": "#0c0d0e"
        }
      }
    }
  }
}
