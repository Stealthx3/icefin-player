  "scripts": [
    "kit.js",
    "panel.js",
    "views.js",
    "data.js",
    "home.js",
    "pivots.js",
    "itemmenu.js",
    "details.js",
    "guide.js",
    "tv.js",
    "library.js",
    "np.js",
    "player.js",
    "settings.js",
    "account.js",
    "interim.js"
  ],
  "sounds": {
