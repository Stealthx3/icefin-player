{
  "$description": "Mosaic: a light-to-mid grey field, bright green tiles, dark lowercase type. Colours sampled from the benchmark target (docs/themes/references/mosaic.json); everything else is Icefin's.",
  "palette": {
    "fog": "#dcdcde",
    "white": "#ffffff",
    "green": "#009a00",
    "greenDeep": "#007a00",
    "charcoal": "#1f2326"
  },
  "color": {
    "background": "{palette.fog}",
    "surface": "{palette.white}",
    "surfaceRaised": "#f6f7f7",
    "text": "{palette.charcoal}",
    "textSecondary": "#505052",
    "accent": "{palette.green}",
    "accentStrong": "{palette.greenDeep}",
    "onAccent": "#ffffff",
    "focus": "{palette.charcoal}",
    "onFocus": "#ffffff",
    "hover": "rgba(47, 143, 31, 0.14)",
    "divider": "rgba(31, 35, 38, 0.12)",
    "error": "#c8372d",
    "onError": "#ffffff",
    "inputBackground": "#ffffff",
    "tile": "{palette.green}",
    "onTile": "#ffffff",
    "backgroundMid": "#c4c4c6",
    "backgroundLow": "#8c8b8e"
  },
  "shape": {
    "cardRadius": "0"
  },
  "osd": {
    "buttonRadius": "0",
    "buttonBackground": "transparent",
    "focusFill": "{color.tile}",
    "focusText": "{color.onTile}",
    "progress": "{color.accent}",
    "progressHeight": "0.3em",
    "titleSize": "2.4em",
    "titleWeight": "300",
    "titleTransform": "lowercase",
    "menuRadius": "0",
    "barBackground": "linear-gradient(0deg, rgb(31 35 38 / 0.92) 0%, rgb(31 35 38 / 0.74) 18%, rgb(31 35 38 / 0.51) 36%, rgb(31 35 38 / 0.29) 54%, rgb(31 35 38 / 0.13) 72%, rgb(31 35 38 / 0.05) 88%, transparent 100%)",
    "headerBackground": "linear-gradient(180deg, rgb(31 35 38 / 0.85) 0%, rgb(31 35 38 / 0.68) 18%, rgb(31 35 38 / 0.47) 36%, rgb(31 35 38 / 0.27) 54%, rgb(31 35 38 / 0.12) 72%, rgb(31 35 38 / 0.04) 88%, transparent 100%)",
    "text": "#ffffff",
    "textSecondary": "rgba(255, 255, 255, 0.75)"
  }
}
