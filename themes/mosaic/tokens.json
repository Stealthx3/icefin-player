{
  "$description": "Mosaic: a light-to-mid grey field, bright green tiles, dark lowercase type. Colours sampled from the benchmark target (docs/themes/references/mosaic.json); everything else is Icefin's.",
  "palette": {
    "fog": "#dcdcde",
    "white": "#ffffff",
    "green": "#009a00",
    "greenDeep": "#007a00",
    "charcoal": "#1f2326"
  },
  "color": {
    "background": "{palette.fog}",
    "surface": "{palette.white}",
    "surfaceRaised": "#f6f7f7",
    "text": "{palette.charcoal}",
    "textSecondary": "#505052",
    "accent": "{palette.green}",
    "accentStrong": "{palette.greenDeep}",
    "onAccent": "#ffffff",
    "focus": "{palette.charcoal}",
    "onFocus": "#ffffff",
    "hover": "rgba(47, 143, 31, 0.14)",
    "divider": "rgba(31, 35, 38, 0.12)",
    "error": "#c8372d",
    "onError": "#ffffff",
    "inputBackground": "#ffffff",
    "tile": "{palette.green}",
    "onTile": "#ffffff",
    "backgroundMid": "#c4c4c6",
