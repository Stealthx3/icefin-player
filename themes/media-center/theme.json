{
  "schema": 1,
  "id": "media-center",
  "name": "Media Center",
  "version": "0.2.0",
  "description": "Icefin's reference theme: a ten-foot start strip of your libraries on a deep blue field with drifting ribbons, a poster wall per library and a details screen with a full backdrop, a soft focus glow and gentle sounds. Original art, sounds and type; no third-party assets.",
  "styles": "styles.css",
  "scripts": [
    "start.js",
    "wall.js",
    "details.js"
  ],
  "sounds": {
    "focus": "sounds/focus.wav",
    "select": "sounds/select.wav",
    "back": "sounds/back.wav",
    "navigate": "sounds/navigate.wav"
  },
  "presets": {
    "teal": {
      "color": {
        "accent": "#2fb7a8",
        "focus": "#7ff0e2",
        "focusGlow": "rgba(127, 240, 226, 0.55)"
      }
    }
  },
  "backdrop": {
    "shader": "backdrop/ribbons.frag",
    "params": {
      "surface": "color.surface",
      "background": "color.background",
      "ribbon": "color.ribbon",
      "ribbonAlt": "color.ribbonAlt",
      "speed": 0.12
    },
    "fps": 24
  }
}
