{
  "schema": 1,
  "id": "media-center",
  "name": "Media Center",
  "version": "0.5.0",
  "description": "Icefin's reference theme: a ten-foot start strip of your libraries on a deep blue field with drifting ribbons, a poster wall per library and a details screen with a full backdrop, a glass focus lens and gentle sounds. Original art, sounds and type; no third-party assets.",
  "styles": "styles.css",
  "scripts": [
    "kit.js",
    "panel.js",
    "itemmenu.js",
    "account.js",
    "start.js",
    "wall.js",
    "library.js",
    "browse.js",
    "tv.js",
    "np.js",
    "details.js",
    "settings.js",
    "viewers.js",
    "player.js"
  ],
  "sounds": {
    "focus": "sounds/focus.wav",
    "select": "sounds/select.wav",
    "back": "sounds/back.wav",
    "navigate": "sounds/navigate.wav",
    "error": "sounds/error.wav"
  },
  "music": {
    "startup": "music/startup.ogg",
    "ambient": "music/ambient.ogg"
  },
  "presets": {
    "teal": {
      "color": {
        "accent": "#2fb7a8",
        "onAccent": "#06122b",
        "focus": "#7ff0e2",
        "focusGlow": "rgba(127, 240, 226, 0.55)"
      }
    }
  },
  "backdrop": {
    "shader": "backdrop/ribbons.frag",
    "params": {
      "surface": "color.surface",
      "background": "color.background",
      "ribbon": "color.ribbon",
      "ribbonAlt": "color.ribbonAlt",
      "speed": 0.12
    },
    "fps": 24
  },
  "schemes": {
    "dark": {
      "name": "Dark",
      "tokens": {
        "color": {
          "background": "#020814",
          "surface": "#0a1838",
          "surfaceRaised": "#0f2250",
          "ribbon": "rgba(60, 120, 230, 0.16)",
          "ribbonAlt": "rgba(40, 170, 230, 0.1)",
          "inputBackground": "rgba(232, 243, 255, 0.08)"
        }
      }
    }
  }
}
