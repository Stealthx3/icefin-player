{
  "$description": "Orbit: a deep green sky over a grey floor, lime tiles, white type. Colours sampled from the benchmark target (docs/themes/references/orbit.json); everything else is Icefin's.",
  "palette": {
    "sky": "#dbe9f2",
    "haze": "#f4f8fb",
    "steel": "#5b6b78",
    "lime": "#9dd515",
    "limeDeep": "#3f6e0c",
    "graphite": "#24303a",
    "forest": "#4f7f11",
    "meadow": "#cce18a",
    "limeLight": "#c4e431",
    "slate": "#6e6f76",
    "snow": "#fbfef9"
  },
  "color": {
    "background": "#2f4f0a",
    "surface": "#3d6410",
    "surfaceRaised": "#4a7514",
    "text": "{palette.snow}",
    "textSecondary": "rgba(251, 254, 249, 0.7)",
    "accent": "{palette.lime}",
    "accentStrong": "{palette.limeDeep}",
    "onAccent": "#ffffff",
    "focus": "{palette.snow}",
    "onFocus": "{palette.limeDeep}",
    "hover": "rgba(251, 254, 249, 0.16)",
    "divider": "rgba(251, 254, 249, 0.2)",
    "error": "#d64541",
    "onError": "#ffffff",
    "inputBackground": "rgba(251, 254, 249, 0.12)",
    "backdropTop": "{palette.forest}",
    "backdropBottom": "#a1a8b6",
    "guide": "#1c2731",
    "backdropMid": "{palette.meadow}",
    "floor": "{palette.slate}",
    "tile": "{palette.limeLight}"
  },
  "shape": {
    "cardRadius": "0.35em"
  },
  "osd": {
    "buttonRadius": "0.15em",
    "focusFill": "{color.focus}",
    "focusText": "{color.onFocus}",
    "progress": "{color.accent}",
    "progressHeight": "0.4em",
    "titleWeight": "300",
    "menuRadius": "0.15em"
  }
}
