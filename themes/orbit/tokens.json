{
  "$description": "Orbit: slate panels over a deep green sky and a grey floor, a lime focus bar, lime tiles, white type. Colours sampled from the benchmark target (docs/themes/references/orbit.json and the pass doc's other screens); everything else is IceFin Player's.",
  "palette": {
    "sky": "#dbe9f2",
    "haze": "#f4f8fb",
    "steel": "#5b6b78",
    "lime": "#9dd515",
    "limeDeep": "#3f6e0c",
    "graphite": "#24303a",
    "forest": "#4f7f11",
    "meadow": "#cce18a",
    "limeLight": "#c4e431",
    "slate": "#6e6f76",
    "snow": "#fbfef9",
    "ink": "#16300a",
    "panel": "#353d45",
    "panelHi": "#4b545d",
    "panelLo": "#2b3239"
  },
  "color": {
    "background": "#2c4a0b",
    "surface": "{palette.panel}",
    "surfaceRaised": "{palette.panelHi}",
    "text": "{palette.snow}",
    "textSecondary": "rgba(251, 254, 249, 0.74)",
    "accent": "{palette.lime}",
    "accentStrong": "{palette.limeDeep}",
    "onAccent": "{palette.ink}",
    "focus": "{palette.lime}",
    "onFocus": "{palette.ink}",
    "hover": "rgba(251, 254, 249, 0.12)",
    "divider": "rgba(251, 254, 249, 0.12)",
    "error": "#d64541",
    "onError": "#ffffff",
    "inputBackground": "#f4f6f2",
    "backdropTop": "{palette.forest}",
    "backdropBottom": "#a1a8b6",
    "guide": "#1c2731",
    "backdropMid": "{palette.meadow}",
    "floor": "{palette.slate}",
    "tile": "{palette.limeLight}",
    "panelLo": "{palette.panelLo}"
  },
  "shape": {
    "cardRadius": "0.3vh"
  },
  "osd": {
    "buttonRadius": "50%",
    "focusFill": "{color.focus}",
    "focusText": "{color.onFocus}",
    "progress": "{color.accent}",
    "progressHeight": "0.4em",
    "titleWeight": "300",
    "menuRadius": "0.15em"
  }
}
