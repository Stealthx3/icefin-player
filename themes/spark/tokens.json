{
  "$description": "Spark: near-black field, a light focus fill and ring, one warm accent. Colours sampled from the benchmark target (docs/themes/references/spark.json); everything else is Icefin's.",
  "palette": {
    "black": "#0b0c0e",
    "coal": "#17191d",
    "slate": "#22252b",
    "white": "#ffffff",
    "amber": "#ff9a1f"
  },
  "color": {
    "background": "{palette.black}",
    "surface": "{palette.coal}",
    "surfaceRaised": "{palette.slate}",
    "text": "#f2f3f5",
    "textSecondary": "rgba(242, 243, 245, 0.62)",
    "accent": "{palette.amber}",
    "accentStrong": "#e0820a",
    "onAccent": "#101010",
    "focus": "{palette.white}",
    "onFocus": "#101010",
    "hover": "rgba(255, 255, 255, 0.12)",
    "divider": "rgba(255, 255, 255, 0.1)",
    "error": "#e5484d",
    "onError": "#ffffff",
    "inputBackground": "rgba(255, 255, 255, 0.08)",
    "heroScrim": "rgba(11, 12, 14, 0.92)",
    "focusFill": "#c9d1d0",
    "onFocusFill": "#0b0c0e",
    "focusRing": "#e8eaea",
    "button": "rgba(255, 255, 255, 0.14)"
  },
  "shape": {
    "cardRadius": "0.3em"
  }
}
